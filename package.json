{
  "name": "grupo-modalidad-40",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build:css": "node -e \"const fs=require('fs');let m=fs.readFileSync('css/styles.css','utf8').replace(/\\/\\*[\\s\\S]*?\\*\\//g,'').replace(/\\r?\\n|\\r/g,' ').replace(/\\s{2,}/g,' ').replace(/\\s*\\{\\s*/g,'{').replace(/\\s*\\}\\s*/g,'}').replace(/\\s*;\\s*/g,';').replace(/\\s*:\\s*/g,':').replace(/\\s*,\\s*/g,',').replace(/;\\}/g,'}').trim();fs.writeFileSync('css/styles.min.css',m,'utf8');\"",
    "test": "node --test tests/*.test.js",
    "swarm": "node swarm/index.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mercadopago": "^3.6.0"
  }
}
