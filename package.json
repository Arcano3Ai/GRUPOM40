{
  "name": "grupo-modalidad-40",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build:css": "node -e \"const fs=require('fs');const css=fs.readFileSync('css/styles.css','utf8');const min=css.replace(/\\/\\*[\\s\\S]*?\\*\\//g,'').replace(/\\s+/g,' ').replace(/\\s*([{}:;,>])\\s*/g,'$1').replace(/;}/g,'}').trim();fs.writeFileSync('css/styles.min.css',min,'utf8');\"",
    "test": "node --test tests/*.test.js",
    "swarm": "node swarm/index.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mercadopago": "^3.6.0"
  }
}
